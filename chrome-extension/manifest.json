{
  "manifest_version": 3,
  "name": "ACOM Canais - Sync Atendare",
  "version": "1.0.0",
  "description": "Extrai dados de negócios do Atendare e sincroniza com o BigQuery via Cloud Function.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.atendare.com/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.atendare.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
